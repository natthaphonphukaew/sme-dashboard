# Copy to .env.local and fill in from Supabase: Project Settings -> API (or API Keys)
# Server-only (no NEXT_PUBLIC_ prefix): never shipped to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon" (legacy) or "publishable" key. NEVER the service_role / secret key.
SUPABASE_ANON_KEY=your-anon-or-publishable-key
